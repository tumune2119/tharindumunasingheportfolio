# EmailJS — contact form (app/contact/page.tsx, components/ContactForm.tsx)
# All three values are public by design: EmailJS is called directly from
# the browser, and it restricts which requests it accepts by domain
# allowlist on your EmailJS dashboard (Account > Security), not by keeping
# these secret. Copy this file to .env.local and fill in your own values
# from https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
